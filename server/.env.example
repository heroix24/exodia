# General server config
PORT=8000
JWT_SECRET=change-me-to-at-least-32-characters
DATABASE_URL=postgres://postgres:postgres@localhost:5432/exodia
UPLOAD_DIR=./uploads

# GitHub automation (required for /repos/:excelId/publish)
GITHUB_PAT=ghp_replace_with_pat

# OpenAI generation (set both vars if you want to use OpenAI)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-5          # any Responses-capable model works

# Claude generation (set both vars if you want to use Claude instead/also)
CLAUDE_API_KEY=sk-ant-your-claude-key
CLAUDE_MODEL=claude-4.5-sonnet